{
  "name": "refijinlabs-bot",
  "version": "0.1.0",
  "description": "REFIJIN LABS Telegram Bot and Mini App",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:webapp": "tsx src/webapp/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc && node scripts/build-webapp.mjs",
    "start": "node dist/index.js",
    "start:webapp": "node dist/webapp/server.js",
    "check:connections": "tsx src/check-connections.ts",
    "db:migrate": "node --import tsx src/db/migrate.cli.ts",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "dotenv": "^17.4.2",
    "grammy": "^1.43.0",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
